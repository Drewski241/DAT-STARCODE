; Singleton-safe treasury coin (educational, not Circuit source).
;
; Exactly ONE CREATE_COIN: recreate treasury with amount - interest.
; Interest leaves via concurrent puzzles/interest_payout.clsp that asserts
; our CREATE_PUZZLE_ANNOUNCEMENT — never a second CREATE_COIN here.
;
; Curry: MOD_HASH AUTHORIZER_PK
; Solution: mode amount interest_amount dest_ph
;
; claim_msg is derived on-chain (not a free solution atom):
;   (sha256tree (list 1 interest_amount dest_ph))
; Must match savings_vault claim-msg / interest_payout assert.

(mod (
  MOD_HASH
  AUTHORIZER_PK
  mode
  amount
  interest_amount
  dest_ph
)

  (defun assert-b32 (atom)
    (if (= (strlen atom) 32) atom (x))
  )

  (defun assert-pos (n)
    (if (> n 0) n (x))
  )

  (defun claim-msg (owed dest)
    (sha256tree (list 1 (assert-pos owed) (assert-b32 dest)))
  )

  (defun treasury-ph (mod_hash auth)
    (sha256tree (c mod_hash (list auth)))
  )

  (defun pay-interest ()
    (if (> interest_amount 0)
      (if (> amount (- interest_amount 1))
        (list
          ; Bind the coin — do not trust solution amount alone.
          (list 73 amount)
          (list 50 AUTHORIZER_PK
            (sha256tree (list mode amount interest_amount dest_ph)))
          (list 63 (claim-msg interest_amount dest_ph))
          (list 51
            (treasury-ph MOD_HASH AUTHORIZER_PK)
            (- amount interest_amount)
          )
        )
        (x)
      )
      (x)
    )
  )

  (if (= mode 1)
    (pay-interest)
    (x)
  )
)
