; Singleton-safe treasury coin (educational).
; Pays interest by recreating THIS coin with amount reduced — exactly one CREATE_COIN.
; Interest value leaves via a concurrent CAT/ephemeral payout spend that asserts our
; announcement (not a second CREATE_COIN from this puzzle).
;
; Curry: MOD_HASH AUTHORIZER_PK
; Solution: mode amount interest_amount dest_ph claim_msg

(mod (
  MOD_HASH
  AUTHORIZER_PK
  mode
  amount
  interest_amount
  dest_ph
  claim_msg
)

  (defun assert-b32 (atom)
    (if (= (strlen atom) 32) atom (x))
  )

  (defun assert-pos (n)
    (if (> n 0) n (x))
  )

  (if (= mode 1)
    (if (> interest_amount 0)
      (if (> amount (- interest_amount 1))
        (list
          (list 50 AUTHORIZER_PK
            (sha256tree (list mode amount interest_amount dest_ph claim_msg)))
          ; Must see matching vault claim (ASSERT_PUZZLE_ANNOUNCEMENT / coin ann — 62)
          (list 62 claim_msg)
          ; Exactly ONE child: treasury remainder (singleton invariant)
          (list 51
            (sha256tree (list MOD_HASH AUTHORIZER_PK))
            (- amount interest_amount)
          )
          ; Announce payout intent for concurrent payout coin / melt path
          (list 60
            (sha256tree (list (assert-b32 dest_ph) (assert-pos interest_amount))))
        )
        (x)
      )
      (x)
    )
    (x)
  )
)
