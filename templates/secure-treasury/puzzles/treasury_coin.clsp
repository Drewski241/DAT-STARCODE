; Singleton-safe treasury coin (educational, not Circuit source).
;
; Exactly ONE CREATE_COIN: recreate treasury with amount - interest.
; Interest leaves via puzzles/interest_payout.clsp (OWNER_PH-bound).
;
; Curry: MOD_HASH AUTHORIZER_PK
; Solution: mode amount interest_amount OWNER_PH
; claim-msg = (sha256tree (list 1 interest_amount OWNER_PH)) - must match vault/payout.
;
; Keep mode logic inline (not a nullary defun over free mod params) - that
; pattern makes cdv/clvm raise at compile or brun time.

(mod (
  MOD_HASH
  AUTHORIZER_PK
  mode
  amount
  interest_amount
  OWNER_PH
)
  (defun sha256tree (TREE)
    (if (l TREE)
      (sha256 2 (sha256tree (f TREE)) (sha256tree (r TREE)))
      (sha256 1 TREE)
    )
  )

  (defun assert-b32 (atom)
    (if (= (strlen atom) 32) atom (x))
  )

  (defun assert-pos (n)
    (if (> n 0) n (x))
  )

  (defun claim-msg (owed owner)
    (sha256tree (list 1 (assert-pos owed) (assert-b32 owner)))
  )

  (defun treasury-ph (mod_hash auth)
    (sha256tree (c mod_hash (list auth)))
  )

  (if (= mode 1)
    (if (> interest_amount 0)
      (if (> amount (- interest_amount 1))
        (list
          (list 73 amount)
          (list 50 AUTHORIZER_PK
            (sha256tree (list mode amount interest_amount OWNER_PH)))
          (list 63 (claim-msg interest_amount OWNER_PH))
          (list 51
            (treasury-ph MOD_HASH AUTHORIZER_PK)
            (- amount interest_amount)
          )
        )
        (x)
      )
      (x)
    )
    (x)
  )
)
