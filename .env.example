# Website / API
WORKER_API_KEY=dev-worker-key-change-me
# Required on Amplify. Do NOT reuse WORKER_API_KEY — rotating the worker
# key used to invalidate every session when AUTH_SECRET was missing.
AUTH_SECRET=change-me-to-a-long-random-string
# Amplify custom domain: share cookies across apex + www
# COOKIE_DOMAIN=.datstarcoder.com
# Optional override for Spirit Poker API (default https://datspiritpoker.com)
# SPIRIT_POKER_API_BASE=https://datspiritpoker.com
CREDITS_PER_JOB=5
# Extra credits when prompt looks like ChiaLisp / .clsp (also NEXT_PUBLIC_ for Studio)
# CREDITS_HARD_DOMAIN=10
# NEXT_PUBLIC_CREDITS_HARD_DOMAIN=10
# Worker: AGENT_HARD_TASK_STEPS=40
# ChiaLisp hard jobs REQUIRE cdv + clvm_tools (default on). Set 0 only for demos.
# REQUIRE_CHIALISP_TOOLING=1
# On the GPU box:
#   pipx install chia-dev-tools   # provides `cdv` for puzzle_hash
#   npm install                   # provides clvm_tools for brun/run
NEXT_PUBLIC_CREDITS_PER_DAT=10
NEXT_PUBLIC_DAT_ASSET_ID=d12fbf63bb015fa0e988509b971ad4c9da7cc5fc30f2499d3aab38c3fadc531c
# Official Chia mainnet burn address (DAT for credits is sent here)
NEXT_PUBLIC_DAT_BURN_ADDRESS=xch1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqm6ks6e8mvy
# Required for live Sage WalletConnect (https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Chia full-node HTTP API used to verify DAT burns (coinset-compatible)
# CHIA_FULLNODE_API=https://api.coinset.org
# Optional override if the DAT→burn CAT puzzle hash ever changes
# DAT_BURN_CAT_PUZZLE_HASH=0x8ba73a509c23617d825adef4144e57ac6fc63144c2c531788ae09d8b71d16f5b

# Set to 1 only if you want demo credits without an on-chain burn
# ALLOW_DEMO_PAYMENTS=1

# Optional: disable the in-process demo worker
# DISABLE_INLINE_WORKER=1

# Customer job workspaces (local default: .data/workspaces)
# On Amplify / multi-instance hosts, set the CloudFormation workspace bucket:
# WORKSPACE_S3_BUCKET=dat-starcoder-workspaces-ACCOUNTID
# Amplify injects AWS_REGION — do not set AWS_* vars there (reserved prefix).
# Optional override only if needed locally / non-Amplify hosts:
# STARCODER_AWS_REGION=us-east-1
#
# If Amplify SSR has no IAM role (CredentialsProviderError), either attach an
# SSR compute role with S3 access, OR set these (NOT AWS_ACCESS_KEY_ID):
# STARCODER_AWS_ACCESS_KEY_ID=
# STARCODER_AWS_SECRET_ACCESS_KEY=
#
# REQUIRED on Amplify: without S3, login succeeds then bounces (ephemeral disk).
# Accounts/jobs are stored at s3://$WORKSPACE_S3_BUCKET/store/store.json
# Optional overrides:
# STORE_S3_BUCKET=dat-starcoder-workspaces-ACCOUNTID
# STORE_S3_KEY=store/store.json

# GitHub OAuth (Studio → Connect GitHub → worker opens PRs)
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: https://datstarcoder.com/api/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional override (defaults to <request-origin>/api/github/callback):
# GITHUB_REDIRECT_URI=https://datstarcoder.com/api/github/callback

# Worker (operator machine)
# DAT_STARCODER_API_BASE=https://your-app.example.com
# WORKER_ID=forge-1
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:14b
# POLL_MS=4000
# AGENT_MAX_STEPS=12
# AGENT_RUN_TIMEOUT_MS=20000
# AGENT_INSTALL_TIMEOUT_MS=180000
# AGENT_VERIFY_TIMEOUT_MS=120000
# AGENT_NATIVE_TOOLS=1
# AGENT_CONTEXT_CHARS=48000
# OLLAMA_NUM_CTX=16384
# AGENT_ALLOW_SHELL=1
# AGENT_REPO_ROOT=/path/to/repo

# HILLCLIMB_LIVE=1
# Optional: npm i -D playwright && npx playwright install chromium
